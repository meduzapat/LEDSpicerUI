                <property name="label" translatable="yes">&lt;big&gt;&lt;b&gt;Free and open-source&lt;/b&gt;&lt;/big&gt;
&lt;span weight="light"&gt;Built in spare time for the community.&lt;/span&gt;

&lt;b&gt;Designed to simplify your config and bring your cabinet to life.&lt;/b&gt;

&lt;span foreground="#4a90e2"&gt;Your support fuels the project.&lt;/span&gt;</property>
                <property name="use-markup">True</property>
                <property name="justify">center</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
